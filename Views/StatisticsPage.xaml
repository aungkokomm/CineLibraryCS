<Page
    x:Class="CineLibraryCS.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    xmlns:models="using:CineLibraryCS.Models"
    Background="{ThemeResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="MovieCardTemplate" x:DataType="models:MovieListItem">
            <local:MovieCardControl Movie="{x:Bind}"/>
        </DataTemplate>
    </Page.Resources>

    <!-- v4.8.0: a dashboard of the library: a summary strip, then quality and
         storage, what's in it, your watching, people, and what to watch next.
         The sections are built in code from one read of the database. -->
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,8,28,40"
                  SizeChanged="OnPageScrollerSizeChanged">
        <StackPanel x:Name="PageStack" MaxWidth="1100" HorizontalAlignment="Stretch" Spacing="28">

            <!-- Page header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Statistics"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"/>
                <TextBlock x:Name="PageTitle" Text="Your collection at a glance"
                           FontSize="13" Opacity="0.7"
                           Foreground="{ThemeResource TextBrush}"/>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid x:Name="SummaryGrid" ColumnSpacing="14" RowSpacing="14"/>
                <TextBlock x:Name="MissingHint" Visibility="Collapsed" TextWrapping="Wrap"
                           FontSize="13" Foreground="#EF4444"/>
            </StackPanel>

            <StackPanel x:Name="SectionsHost" Spacing="36"/>

        </StackPanel>
    </ScrollViewer>
</Page>
