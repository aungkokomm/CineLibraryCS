<UserControl
    x:Class="CineLibraryCS.Views.TvEpisodeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- v4.8.0: one row per episode in a list that scrolls down the page: its
         number, the picture, the title, date, length and quality, the plot, and
         Favorite and Watched, always there and big enough to hit. -->
    <Grid x:Name="CardRoot" Height="170">
        <Border x:Name="CardBorder" Style="{StaticResource CardSurfaceStyle}"
                BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NumberText" Width="36" Margin="0,0,16,0" FontSize="20" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}" Opacity="0.7" TextAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Thumbnail (16:9) -->
                <Border x:Name="ThumbFrame" Grid.Column="1" Width="256" Height="144" CornerRadius="8"
                        Margin="0,0,16,0">
                    <Grid>
                        <Grid x:Name="ThumbPlaceholder">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="{ThemeResource PlaceholderTopColor}"/>
                                    <GradientStop Offset="1" Color="{ThemeResource PlaceholderBottomColor}"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <TextBlock Text="🎬" FontSize="28" Opacity="0.7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Image x:Name="ThumbImage" Stretch="UniformToFill"/>

                        <!-- dim overlay when watched -->
                        <Border x:Name="WatchedDim" Background="#88000000" Visibility="Collapsed"/>
                                <!-- v4.10.0: how far it was watched -->
                                <Grid x:Name="ResumeLine" Height="4" VerticalAlignment="Bottom" Background="#99000000" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ResumeDone"/>
                                        <ColumnDefinition x:Name="ResumeRest"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource BrandPurpleBrush}"/>
                                </Grid>

                        <!-- v4.6.0: an aired episode you don't have -->
                        <Border x:Name="NotInLibraryBadge" Visibility="Collapsed"
                                Background="#CC000000" CornerRadius="6" Padding="8,3"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <TextBlock Text="Not in your library" FontSize="11" Foreground="White"/>
                        </Border>

                        <!-- Hover overlay: big play -->
                        <Border x:Name="HoverOverlay" Background="#66000000" Opacity="0" Visibility="Collapsed">
                            <Button Click="OnPlay"
                                    Background="{StaticResource BrandPurpleBrush}" Foreground="White"
                                    BorderThickness="0" CornerRadius="20" Padding="16,8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="▶ Play"/>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- Info -->
                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="MetaText" FontSize="13"
                               Foreground="{ThemeResource TextBrush}" Opacity="0.7"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="PlotText" FontSize="14" LineHeight="21"
                               Foreground="{ThemeResource TextBrush}" Opacity="0.85"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- v4.7.0 (#25): Favorite and Watched, as on a movie card -->
                <StackPanel x:Name="ToggleButtons" Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="FavBtn" Click="OnToggleFavorite"
                            Style="{StaticResource RowIconToggleStyle}"
                            Width="40" Height="40" CornerRadius="20"
                            AutomationProperties.Name="Favorite">
                        <FontIcon x:Name="FavIcon" FontSize="16"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                    </Button>
                    <Button x:Name="WatchedBtn" Click="OnToggleWatched"
                            Style="{StaticResource RowIconToggleStyle}"
                            Width="40" Height="40" CornerRadius="20"
                            AutomationProperties.Name="Watched">
                        <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="16"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
