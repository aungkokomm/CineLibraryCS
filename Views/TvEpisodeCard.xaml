<UserControl
    x:Class="CineLibraryCS.Views.TvEpisodeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="CardRoot" Width="270" Height="232">
        <Border x:Name="CardBorder" Background="{ThemeResource CardBrush}"
                BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Thumbnail (16:9) -->
                <Grid Grid.Row="0" Height="152">
                    <Grid x:Name="ThumbPlaceholder" CornerRadius="10,10,0,0">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="{ThemeResource PlaceholderTopColor}"/>
                                <GradientStop Offset="1" Color="{ThemeResource PlaceholderBottomColor}"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <TextBlock Text="🎬" FontSize="32" Opacity="0.7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Border CornerRadius="10,10,0,0">
                        <Image x:Name="ThumbImage" Stretch="UniformToFill"/>
                    </Border>

                    <!-- dim overlay when watched -->
                    <Border x:Name="WatchedDim" CornerRadius="10,10,0,0"
                            Background="#88000000" Visibility="Collapsed"/>

                    <!-- v4.6.0: an aired episode you don't have -->
                    <Border x:Name="NotInLibraryBadge" Visibility="Collapsed"
                            Background="#CC000000" CornerRadius="6" Padding="8,3"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <TextBlock Text="Not in your library" FontSize="11" Foreground="White"/>
                    </Border>

                    <!-- Episode code badge -->
                    <Border Background="#CC000000" CornerRadius="6"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Padding="6,2" Margin="6">
                        <TextBlock x:Name="CodeText" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- v2.9 — Favorite + Watched badges stacked at top-right.
                         Both can be visible simultaneously. -->
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6">
                        <Border x:Name="FavBadge" Background="#CC000000" CornerRadius="11"
                                Width="22" Height="22" Visibility="Collapsed">
                            <FontIcon Glyph="&#xEB52;" FontSize="11" Foreground="#F43F5E"
                                      FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="WatchedBadge" Background="#CC22C55E" CornerRadius="11"
                                Width="22" Height="22" Visibility="Collapsed">
                            <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Hover overlay: big play -->
                    <Border x:Name="HoverOverlay" CornerRadius="10,10,0,0"
                            Background="#66000000" Opacity="0" Visibility="Collapsed">
                        <Button Click="OnPlay"
                                Background="{StaticResource BrandPurpleBrush}" Foreground="White"
                                BorderThickness="0" CornerRadius="20" Padding="16,8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▶ Play"/>
                        </Button>
                    </Border>
                </Grid>

                <!-- Info -->
                <Grid Grid.Row="1" Padding="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="WrapWholeWords"/>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MetaText" Grid.Column="0" FontSize="11"
                                   Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
                        <!-- v4.7.0 (#25): Favorite and Watched, as on a movie card -->
                        <StackPanel x:Name="ToggleButtons" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="FavBtn" Click="OnToggleFavorite"
                                    Style="{StaticResource RowIconToggleStyle}"
                                    Width="26" Height="26" CornerRadius="13"
                                    AutomationProperties.Name="Favorite">
                                <FontIcon x:Name="FavIcon" FontSize="12"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="WatchedBtn" Click="OnToggleWatched"
                                    Style="{StaticResource RowIconToggleStyle}"
                                    Width="26" Height="26" CornerRadius="13"
                                    AutomationProperties.Name="Watched">
                                <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="12"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
