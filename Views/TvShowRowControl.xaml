<UserControl
    x:Class="CineLibraryCS.Views.TvShowRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- v4.7.0 (#25): a show in list view on Favorites, To Watch, lists and
         search, lined up with the movie rows (MovieRowControl). The page opens
         the show on Tapped, as it does for a show card. -->
    <Border Background="Transparent" Padding="0,1"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Border x:Name="RowBorder" Style="{StaticResource CardSurfaceStyle}"
                CornerRadius="8" Padding="12,10"
                BorderBrush="Transparent" BorderThickness="2">
            <Grid>
                <!-- The movie row's columns; Play's column stays empty here -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Thumbnail -->
                <Border Grid.Column="0" Width="56" Height="84" CornerRadius="4">
                    <Grid>
                        <Image x:Name="ThumbImage" Stretch="UniformToFill"/>
                        <TextBlock x:Name="ThumbPlaceholder" Text="📺" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Main info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="RowTitle" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="RowFav" Text="♥" Foreground="#F43F5E"
                                   FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="RowMeta" FontSize="12"
                               Foreground="{ThemeResource MutedBrush}" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                        <Ellipse x:Name="DriveDot" Width="7" Height="7" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DriveLabel" FontSize="11"
                                   Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Rating -->
                <TextBlock Grid.Column="3" x:Name="RowRating"
                           Foreground="#F59E0B" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Episodes watched, where a movie row has its buttons -->
                <TextBlock Grid.Column="4" x:Name="RowProgress" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           ToolTipService.ToolTip="Episodes watched"/>

                <!-- Status -->
                <Border Grid.Column="5" x:Name="RowStatusBadge"
                        CornerRadius="4" Padding="8,3"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="RowStatusText" FontSize="11" FontWeight="Bold"
                               Foreground="{ThemeResource TextBrush}"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
