<Page
    x:Class="CineLibraryCS.Views.CollectionsBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    xmlns:controls="using:CineLibraryCS.Controls"
    Background="{ThemeResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: one row (v3.9.0), like All movies: title + count |
             watched pills | sort + poster size. HeaderBar wraps it when narrow. -->
        <controls:HeaderBar Grid.Row="0" Margin="24,8,24,10" HorizontalSpacing="16" VerticalSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Collections" FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="PageCountText" Text=""
                           FontSize="13" Foreground="{ThemeResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- v3.8.0: watched filter, same pills as All movies. -->
            <StackPanel x:Name="CollFilterPills" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="CollFilterAll" Content="All" Tag="all"
                        Style="{StaticResource PillButtonActiveStyle}" Click="OnFilterClick"/>
                <Button x:Name="CollFilterUnwatched" Content="Unwatched" Tag="unwatched"
                        Style="{StaticResource PillButtonStyle}" Click="OnFilterClick"
                        ToolTipService.ToolTip="Collections with movies you haven't watched yet"/>
                <Button x:Name="CollFilterWatched" Content="Watched" Tag="watched"
                        Style="{StaticResource PillButtonStyle}" Click="OnFilterClick"
                        ToolTipService.ToolTip="Collections you've watched every movie of"/>
            </StackPanel>

            <!-- v3.8.0: sort + poster size, matching All movies. -->
            <StackPanel x:Name="CollToolbar" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <ComboBox x:Name="CollSortCombo"
                          SelectionChanged="OnSortChanged"
                          Background="{ThemeResource InputBgBrush}"
                          Foreground="{ThemeResource TextBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}"
                          Width="160" Height="36" CornerRadius="8"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Sort collections">
                    <ComboBoxItem Tag="name:asc"        Content="Name ↑"/>
                    <ComboBoxItem Tag="name:desc"       Content="Name ↓"/>
                    <ComboBoxItem Tag="count:desc"      Content="Movies ↓"/>
                    <ComboBoxItem Tag="count:asc"       Content="Movies ↑"/>
                    <ComboBoxItem Tag="year:desc"       Content="Year ↓"/>
                    <ComboBoxItem Tag="year:asc"        Content="Year ↑"/>
                    <ComboBoxItem Tag="date_added:desc" Content="Date Added ↓"/>
                    <ComboBoxItem Tag="date_added:asc"  Content="Date Added ↑"/>
                </ComboBox>
                <DropDownButton Background="{ThemeResource InputBgBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                CornerRadius="8" Height="36" Padding="12,0,10,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Poster size"
                                ToolTipService.ToolTip="Poster size">
                    <TextBlock x:Name="CollDensityLabel" Text="Size: M" FontSize="13"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem x:Name="CollDensityS" Text="Small" Tag="S" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="S" Click="OnDensityClick"/>
                            <RadioMenuFlyoutItem x:Name="CollDensityM" Text="Medium" Tag="M" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="M" Click="OnDensityClick"/>
                            <RadioMenuFlyoutItem x:Name="CollDensityL" Text="Large" Tag="L" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="L" Click="OnDensityClick"/>
                            <RadioMenuFlyoutItem x:Name="CollDensityXL" Text="Extra large" Tag="XL" GroupName="colldensity"
                                                 KeyboardAcceleratorTextOverride="XL" Click="OnDensityClick"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </controls:HeaderBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsRepeater x:Name="GridRepeater" Margin="24,0,24,24" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled">
                    <ItemsRepeater.Layout>
                        <!-- Card sizes follow the S / M / L / XL picker, the
                             same sizes as All TV shows. Sizes and gaps: CardCell.FitGrid -->
                        <UniformGridLayout x:Name="CollGridLayout" MinItemWidth="170" MinItemHeight="309"
                                           MinColumnSpacing="24" MinRowSpacing="28"
                                           ItemsStretch="Uniform"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <!-- v3.8.0: built like a movie card, and a green tick marks a
                             fully watched set. v4.8.0: the cover on its own, the name,
                             count and progress under it, as on show cards. -->
                        <DataTemplate x:DataType="local:CollectionTileVm">
                            <!-- v4.4.0 (#18): the cell sizes the card like movie and show cards -->
                            <controls:CardCell CardWidth="{x:Bind CardWidth}" CardHeight="{x:Bind CardHeight}">
                            <Button Background="Transparent" BorderThickness="0"
                                    Padding="0" CornerRadius="10"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Click="OnTileClick"
                                    Tag="{x:Bind Id}"
                                    AutomationProperties.Name="{x:Bind Name}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="10" Background="{ThemeResource PlaceholderBgBrush}">
                                        <Grid>
                                            <!-- v4.8.0: a stand-in cover when no film in it has a poster -->
                                            <Grid Background="{x:Bind PlaceholderBrush}" Visibility="{x:Bind PlaceholderVisibility}">
                                                <StackPanel VerticalAlignment="Center" Margin="12,0" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B2;" FontSize="20" Foreground="White" Opacity="0.45"
                                                              FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="{x:Bind PlaceholderFontSize}"
                                                               FontWeight="Bold" Foreground="White"
                                                               TextWrapping="WrapWholeWords" MaxLines="4" TextTrimming="CharacterEllipsis"
                                                               TextAlignment="Center" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <Image Stretch="UniformToFill"
                                                   Source="{x:Bind CoverImage, Mode=OneWay}"/>
                                            <Border Background="#CC22C55E" CornerRadius="10"
                                                    Width="22" Height="22" Margin="8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Visibility="{x:Bind WatchedVisibility}">
                                                <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- the same block as the show card's caption (TvShowCard.CaptionHeight) -->
                                    <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="3">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <!-- v4.4.0 (#18): how many you've watched, as on show cards -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind CountText}" FontSize="12"
                                                       Foreground="{ThemeResource MutedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ProgressText}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                        </Grid>
                                        <Grid Height="3" CornerRadius="2" Background="{ThemeResource BorderBrush}" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind DoneWidth}"/>
                                                <ColumnDefinition Width="{x:Bind LeftWidth}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="2" Background="#A78BFA"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            </controls:CardCell>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,80,0,24" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="44" Opacity="0.5"
                              FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Foreground="{ThemeResource MutedBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyTitle" Text="No collections yet"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint" Text="MediaElch collections (franchises, sagas) appear here once at least two of their movies are in your library and tagged in their .nfo files."
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
