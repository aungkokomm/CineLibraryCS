<UserControl
    x:Class="CineLibraryCS.Views.MovieCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    IsTabStop="True" UseSystemFocusVisuals="False" AllowFocusOnInteraction="False">

    <!-- No ToolTip on the card root: WinUI tooltips get orphaned on screen
         when a hovered card is recycled out by the ItemsRepeater during a
         scroll. The title is already on the card, so the tooltip added
         little. -->
    <!-- v4.1.0: no fixed width; see MeasureOverride (fills its grid cell).
         v4.8.0: no fixed height either; the grid keeps the card's shape. -->
    <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="CardLift" Y="0"/>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- v4.8.0: the poster on its own, the title and year under it -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="CardBorder" Background="{ThemeResource CardBrush}" CornerRadius="10"
                BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <!-- Poster image -->
                <Image x:Name="PosterImage" Stretch="UniformToFill"
                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

                <!-- v4.8.0: a stand-in poster when there's none, the title in large
                     type on colours picked from it (PlaceholderArt). While a poster
                     loads, the card's own background shows instead. -->
                <Grid x:Name="PosterPlaceholder" Visibility="Collapsed">
                    <StackPanel x:Name="PlaceholderText" VerticalAlignment="Center" Margin="12,0" Spacing="6">
                        <FontIcon Glyph="&#xE8B2;" FontSize="20" Foreground="White" Opacity="0.45"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        <TextBlock x:Name="PlaceholderTitle" FontWeight="Bold" Foreground="White"
                                   TextWrapping="WrapWholeWords" MaxLines="4" TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PlaceholderYear" FontSize="12" Foreground="#B3FFFFFF"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="4" Margin="6"
                            VerticalAlignment="Top" HorizontalAlignment="Left">
                    <!-- Status badge: small dot + label, corner -->
                    <Border x:Name="StatusBadge"
                            Background="#CC000000" CornerRadius="8"
                            VerticalAlignment="Center"
                            Padding="6,2" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" FontSize="9" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- v4.8.0: added in the last two weeks -->
                    <Border x:Name="NewBadge" Background="{StaticResource BrandPurpleBrush}" CornerRadius="8"
                            Padding="7,2" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="NewBadgeText" Text="NEW" FontSize="9" FontWeight="Bold" CharacterSpacing="60" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Favorite heart top-right (v4.5.0 #23: a heart, not a star,
                     right under the hover panel's heart button) -->
                <Border x:Name="FavBadge" Style="{StaticResource CardIconBadgeStyle}"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xEB52;" FontSize="14" Foreground="#F43F5E"
                              FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                </Border>

                <!-- Watched tick bottom-left -->
                <Border x:Name="WatchedBadge"
                        Background="#CC22C55E" CornerRadius="10"
                        Width="22" Height="22" Padding="0"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="8" Visibility="Collapsed">
                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- v4.8.0: 4K and HDR / Dolby Vision, bottom-right -->
                <StackPanel x:Name="QualityChips" Orientation="Horizontal" Spacing="4" Margin="8"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Border x:Name="Chip4K" Background="#B3000000" CornerRadius="4" Padding="5,1"
                            BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed">
                        <TextBlock Text="4K" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border x:Name="ChipHdr" Background="#B3000000" CornerRadius="4" Padding="5,1"
                            BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed">
                        <TextBlock x:Name="ChipHdrText" FontSize="10" FontWeight="Bold" Foreground="#FACC15"/>
                    </Border>
                </StackPanel>

                <!-- Hover overlay -->
                <Border x:Name="HoverOverlay" CornerRadius="10"
                        Background="#CC000000" Opacity="0" Visibility="Collapsed">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="GenresText" FontSize="11"
                                       Foreground="#E0E0E0"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                            <!-- v4.5.0: ▶ Play when the drive is connected (a double-click
                                 did this, which few found); otherwise the drive it's on -->
                            <Button x:Name="HoverPlayBtn" Content="▶ Play" Click="OnHoverPlay"
                                    Style="{StaticResource PillButtonActiveStyle}"
                                    HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="HoverDriveText" FontSize="11" Foreground="#F0997B"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"
                                       Visibility="Collapsed"/>
                            <Button Content="View Details" Click="OnViewDetails"
                                    Style="{StaticResource PillButtonStyle}"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- v4.5.0 (#23): Watchlist, Watched and Favorite as icons, dim
                             when off. The heart sits right over the favorite badge. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8"
                                    VerticalAlignment="Top" HorizontalAlignment="Right">
                            <Button x:Name="WatchlistIconBtn" Click="OnWatchlistToggle"
                                    Style="{StaticResource CardIconToggleStyle}"
                                    AutomationProperties.Name="Watchlist">
                                <FontIcon x:Name="WatchlistIcon" FontSize="14"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="WatchedIconBtn" Click="OnWatchedToggle"
                                    Style="{StaticResource CardIconToggleStyle}"
                                    AutomationProperties.Name="Watched">
                                <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="14"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="FavIconBtn" Click="OnFavoriteToggle"
                                    Style="{StaticResource CardIconToggleStyle}"
                                    AutomationProperties.Name="Favorite">
                                <FontIcon x:Name="FavIcon" FontSize="14"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- v4.8.0: title, year and runtime, and the rating under the poster, on
             the page (CaptionHeight in the code is this block's height) -->
        <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="1">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       PointerEntered="OnTitlePointerEntered" PointerExited="OnTitlePointerExited"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="MetaText" FontSize="12"
                           Foreground="{ThemeResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" x:Name="RatingInline" FontSize="12"
                           FontWeight="SemiBold" Foreground="#F59E0B"
                           Margin="6,0,0,0" Visibility="Collapsed"/>
            </Grid>
        </StackPanel>

        <!-- v4.8.0: the whole title while the pointer is on one cut short, grown up
             from the title over the poster (ShowFullTitle). Part of the card, as a
             tooltip was left on screen when its card was recycled. -->
        <Border x:Name="FullTitle" VerticalAlignment="Bottom" Margin="-4,0" Padding="5,3"
                CornerRadius="6" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed"
                Background="{ThemeResource ToolTipBackground}" BorderBrush="{ThemeResource ToolTipBorderBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FullTitleShift"/>
            </Border.RenderTransform>
            <TextBlock x:Name="FullTitleText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource ToolTipForeground}" TextWrapping="WrapWholeWords"/>
        </Border>

        <!-- v2.5 — selection outline + corner ✓ chip. Shown when the card is
             part of the current multi-select set. Sits above CardBorder so it
             overlays the poster but underneath the right-click flyout. -->
        <Border x:Name="SelectedOutline" CornerRadius="10"
                BorderBrush="{StaticResource BrandPurpleBrush}"
                BorderThickness="2"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
        <Border x:Name="SelectedTick" CornerRadius="10"
                Background="{StaticResource BrandPurpleBrush}"
                Width="22" Height="22"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,8,8,0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- v4.8.0: the card the keyboard is on (arrow keys move it), round the poster -->
        <Border x:Name="FocusRing" Margin="-4" CornerRadius="13" BorderThickness="3"
                BorderBrush="{ThemeResource TextBrush}"
                IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</UserControl>
