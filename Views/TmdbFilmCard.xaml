<UserControl
    x:Class="CineLibraryCS.Views.TmdbFilmCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 5.4.0: a film that isn't in the library: on an actor's or director's page
         and on the Wishlist. The poster opens it on TMDb; + puts it on the Wishlist.
         Sized like the movie cards (MeasureOverride). No tooltip on the card itself:
         one gets left on screen when the card is recycled while scrolling. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Button x:Name="PosterBtn" Click="OnPosterClick" Padding="0" CornerRadius="10"
                Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid CornerRadius="10" Background="{ThemeResource CardBrush}">
                <TextBlock x:Name="PlaceholderTitle" Margin="10" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource MutedBrush}"/>
                <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                <Border x:Name="OwnedBadge" Visibility="Collapsed" Background="#CC22C55E" CornerRadius="8"
                        Padding="6,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="IN YOUR LIBRARY" FontSize="9" FontWeight="Bold" CharacterSpacing="60" Foreground="White"/>
                </Border>
            </Grid>
        </Button>

        <Grid Grid.Row="1" Margin="2,8,0,0" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{ThemeResource TextBrush}"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{ThemeResource MutedBrush}"/>
            </StackPanel>
            <Button x:Name="WishBtn" Grid.Column="1" Click="OnWishClick" Width="30" Height="30" Padding="0"
                    CornerRadius="15" VerticalAlignment="Top" Margin="0,-2,0,0"
                    Background="Transparent" BorderThickness="0">
                <FontIcon x:Name="WishIcon" FontSize="14" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
