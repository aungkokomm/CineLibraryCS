<Window
    x:Class="CineLibraryCS.Views.MovieDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CineLibraryCS.Models"
    xmlns:controls="using:CineLibraryCS.Controls"
    Title="CineLibrary">

    <Grid x:Name="RootGrid" Background="{ThemeResource SidebarBrush}">
        <Grid.Resources>
            <!-- v4.5.0: a film in the collection and "More by" strips. The title
                 keeps room for two lines, so every tile is the same height. -->
            <DataTemplate x:Key="RelatedMovieTemplate" x:DataType="models:RelatedMovie">
                <Button Width="120" Background="Transparent" BorderThickness="0" Padding="0"
                        CornerRadius="8" HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                        Tag="{x:Bind Id}" Click="OnRelatedClick"
                        AutomationProperties.Name="{x:Bind Title}">
                    <StackPanel Spacing="6">
                        <Grid Width="120" Height="180">
                            <Border CornerRadius="8" Background="{ThemeResource PlaceholderBgBrush}"
                                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="🎬" FontSize="30" Opacity="0.7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Stretch="UniformToFill" Source="{x:Bind PosterBitmap, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                            <Border Background="#CC22C55E" CornerRadius="10" Width="20" Height="20"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                    Visibility="{x:Bind IsWatched}">
                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- the film this window shows, in its collection -->
                            <Border CornerRadius="8" BorderThickness="2"
                                    BorderBrush="{StaticResource BrandPurpleBrush}"
                                    Visibility="{x:Bind IsCurrent}"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" Height="32" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}" TextWrapping="WrapWholeWords"
                                   TextTrimming="CharacterEllipsis" MaxLines="2"/>
                        <!-- 4.10.0 (#25): clear of the button's round corner, which clips what's under it -->
                        <TextBlock Text="{x:Bind YearText}" FontSize="11" Margin="0,-4,0,6"
                                   Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </Button>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom titlebar drag region. v4.8.0 (#25): the main window's, so the
             two read as one window -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                <Image Source="ms-appx:///Assets/icon.ico"
                       Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="CineLibrary" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Scroll area + sticky action bar overlay (v2.3) -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="24"
                          ViewChanged="OnContentScrolled" SizeChanged="OnContentScrollerSizeChanged">
            <!-- v4.2.0 (#14): fills the window. The code picks a narrow, standard
                 or wide arrangement from the width (OnContentScrollerSizeChanged). -->
            <StackPanel x:Name="ContentStack" HorizontalAlignment="Stretch">

                <!-- Hero fanart (v2.3 — taller, layered gradient, vignette, IMDb/TMDb pills) -->
                <Border x:Name="HeroBorder" Height="340" CornerRadius="12"
                        Background="{ThemeResource HeroBgBrush}"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                        <!-- Vertical gradient — strong on the bottom so titles stay readable -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0"    Color="#33000000"/>
                                    <GradientStop Offset="0.55" Color="#22000000"/>
                                    <GradientStop Offset="1"    Color="#E6000000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- Horizontal vignette — subtle edge darkening -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0"    Color="#55000000"/>
                                    <GradientStop Offset="0.5"  Color="#00000000"/>
                                    <GradientStop Offset="1"    Color="#55000000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- IMDb / TMDb badge pills, top-right -->
                        <StackPanel x:Name="ExternalLinksPanel" Orientation="Horizontal"
                                    Spacing="6" Margin="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="ImdbLinkBtn" Visibility="Collapsed"
                                    Click="OnOpenImdb"
                                    Background="#F5C518" Foreground="#000000"
                                    BorderThickness="0" CornerRadius="4"
                                    Padding="8,3" FontSize="11" FontWeight="Bold"
                                    Content="IMDb"/>
                            <Button x:Name="TmdbLinkBtn" Visibility="Collapsed"
                                    Click="OnOpenTmdb"
                                    Background="#01D277" Foreground="#000000"
                                    BorderThickness="0" CornerRadius="4"
                                    Padding="8,3" FontSize="11" FontWeight="Bold"
                                    Content="TMDb"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="14"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                            <!-- v4.8.0 (#25): back to the library, as from a page of the main window
                                 (also Esc and the mouse's back button) -->
                            <Button Click="OnBackToLibrary" Style="{StaticResource CardIconToggleStyle}" Width="Auto"
                                    AutomationProperties.Name="Back to library"
                                    ToolTipService.ToolTip="Back to library (Esc)">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0,14,0">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="White"
                                              FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                    <TextBlock Text="Library" FontSize="13" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <!-- v4.5.0: the previous / next movie of the grid this window
                                 was opened from (also the ← and → keys) -->
                            <StackPanel x:Name="BrowseNav" Orientation="Horizontal" Spacing="6"
                                        Visibility="Collapsed">
                                <Button x:Name="PrevMovieBtn" Click="OnPrevMovie"
                                        Style="{StaticResource CardIconToggleStyle}"
                                        AutomationProperties.Name="Previous movie"
                                        ToolTipService.ToolTip="Previous movie (←)">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="White"
                                              FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                                <Border x:Name="BrowsePosPill" Height="30" Padding="12,0" CornerRadius="15"
                                        Background="#99000000" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <TextBlock x:Name="BrowsePos" FontSize="12" Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Button x:Name="NextMovieBtn" Click="OnNextMovie"
                                        Style="{StaticResource CardIconToggleStyle}"
                                        AutomationProperties.Name="Next movie"
                                        ToolTipService.ToolTip="Next movie (→)">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="White"
                                              FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Poster + Meta row -->
                <Grid x:Name="TopGrid" Margin="0,-120,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Poster column: poster card + below-poster info card -->
                    <StackPanel Grid.Column="0" Margin="16,0,24,0" VerticalAlignment="Top"
                                Spacing="12">
                        <!-- Poster — drop shadow + thin border for depth -->
                        <Border x:Name="PosterFrame" Width="200" Height="290" CornerRadius="12"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                Background="{ThemeResource PlaceholderBgBrush}">
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>
                            <Border.Translation>0,0,32</Border.Translation>
                            <Grid>
                                <TextBlock x:Name="PosterPlaceholder" Text="🎬" FontSize="56"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- Meta -->
                    <StackPanel x:Name="MetaStack" Grid.Column="1" Spacing="10" VerticalAlignment="Top"
                                Margin="0,140,0,0">
                        <TextBlock x:Name="DetailTitle" FontSize="34" FontWeight="Bold"
                                   Foreground="{ThemeResource TextBrush}"
                                   TextWrapping="Wrap" LineHeight="40"/>
                        <TextBlock x:Name="OriginalTitle" FontSize="14" FontStyle="Italic"
                                   Foreground="{ThemeResource MutedBrush}" Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                        <!-- Tagline with a thin colored accent bar -->
                        <Grid x:Name="TaglineWrap" Visibility="Collapsed" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource BrandPurpleBrush}"
                                    CornerRadius="2" Margin="0,2,8,2"/>
                            <TextBlock x:Name="Tagline" Grid.Column="1"
                                       FontStyle="Italic" FontSize="14"
                                       Foreground="{StaticResource BrandPurpleBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel x:Name="ChipsPanel" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"/>
                        <!-- v4.5.0 (#24): genres right under the rating / year / runtime line -->
                        <controls:WrapPanel x:Name="GenreChips" HorizontalSpacing="6" VerticalSpacing="6"
                                            Visibility="Collapsed"/>
                        <!-- Tech badges (v5.3.0: the ratings beside them moved into the facts card) -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0"
                                    VerticalAlignment="Center">
                            <ItemsControl x:Name="TechBadges" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- v4.2.0 (#14): genres, director, studio and file info, beside the
                         plot in a wide window -->
                    <StackPanel x:Name="SideStack" Grid.Column="2" Margin="40,140,0,0"
                                VerticalAlignment="Top"/>
                </Grid>

                <!-- Location, actions, lists and tags: under the poster, or beside it
                     in a wide window (v4.2.0) -->
                <StackPanel x:Name="ActionsBlock">
                    <!-- Drive location -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="Located on:" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
                        <Ellipse x:Name="DriveStatusDot" Width="8" Height="8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DriveText" FontSize="12"
                                   Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Actions (wrap onto a second line in narrow windows) -->
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="0,12,0,0">
                        <Button x:Name="PlayBtn" Click="OnPlay"
                                Background="#A78BFA" Foreground="White"
                                BorderThickness="0" CornerRadius="8" Padding="16,8">
                            <TextBlock Text="▶ Play"/>
                        </Button>
                        <!-- v4.6.0: the trailer link from the .nfo -->
                        <Button x:Name="TrailerBtn" Click="OnTrailer"
                                Visibility="Collapsed"
                                Background="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"
                                ToolTipService.ToolTip="Watch the trailer in your web browser"/>
                        <Button x:Name="FolderBtn" Click="OnOpenFolder"
                                Background="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="FavBtn" Click="OnToggleFav"
                                Background="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="WatchedBtn" Click="OnToggleWatched"
                                Background="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="WatchlistBtn" Click="OnToggleWatchlist"
                                Background="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                        <Button x:Name="ListsBtn"
                                Background="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8">
                            <Button.Flyout>
                                <MenuFlyout x:Name="ListsFlyout" Placement="Bottom" Opening="OnListsFlyoutOpening"/>
                            </Button.Flyout>
                        </Button>
                        <!-- v5.3.0: with the other buttons, as on the TV page; the Notes card shows once there's a note -->
                        <Button x:Name="NoteAddBtn" Click="OnNoteEditStart" Visibility="Collapsed"
                                Background="{ThemeResource CardBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                CornerRadius="8" Padding="12,8"/>
                    </controls:WrapPanel>

                    <!-- v3.4 — TMDB enrichment: fill gaps in the app, then (for real
                         library movies on an online drive) sync the result home. -->
                    <StackPanel x:Name="TmdbActionsRow" Orientation="Horizontal" Spacing="8"
                                Margin="0,8,0,0" Visibility="Collapsed">
                        <Button x:Name="FetchTmdbBtn" Click="OnFetchMissing"
                                Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="8" Padding="12,8"
                                ToolTipService.ToolTip="Look this movie up on TMDb and fill in only the details it's missing">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                <TextBlock Text="Fetch missing info from TMDB"/>
                            </StackPanel>
                        </Button>
                        <!-- v4.6.0: read the folder again, e.g. after editing it in Essentials -->
                        <Button x:Name="ReloadNfoBtn" Click="OnReloadNfo"
                                Background="{ThemeResource CardBrush}" Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}" CornerRadius="8" Padding="12,8"
                                ToolTipService.ToolTip="Read this movie's .nfo and pictures from the drive again, for example after you edit it in CineLibrary Essentials">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                <TextBlock Text="Reload from .nfo"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SyncDriveBtn" Click="OnSyncToDrive" Visibility="Collapsed"
                                Background="{ThemeResource CardBrush}" Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource BorderBrush}" CornerRadius="8" Padding="12,8"
                                ToolTipService.ToolTip="Write the fetched poster, cast and details into this movie's folder on the drive">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="14"
                                          FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                <TextBlock Text="Sync to drive"/>
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="TmdbBusy" IsActive="False" Width="18" Height="18"
                                      VerticalAlignment="Center"/>
                        <TextBlock x:Name="TmdbStatus" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource MutedBrush}" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- v2.5 — Lists this movie is on. Each chip has a ✕ that
                         removes the movie from that list immediately (with Undo
                         in the toast). The whole row hides when there are none. -->
                    <ItemsControl x:Name="ListChipsRepeater" Margin="0,10,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- v2.9 — Free-form tags. Chips with ✕ to remove; an
                         "+ Add tag" affordance opens an autocomplete that
                         suggests existing tags and accepts new names. The
                         whole row hides when there are no tags AND the input
                         is collapsed. -->
                    <StackPanel x:Name="TagsRow" Orientation="Horizontal" Spacing="6"
                                Margin="0,10,0,0">
                        <TextBlock Text="🏷" FontSize="14" VerticalAlignment="Center" Opacity="0.7"/>
                        <ItemsControl x:Name="TagChipsRepeater">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- v4.6.0: tags from the .nfo (no ✕: they're changed in the .nfo) -->
                        <ItemsControl x:Name="NfoTagChipsRepeater">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="AddTagBtn" Click="OnAddTagClick"
                                Background="{ThemeResource ChipBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="10,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="+ Add tag" FontSize="11"
                                       Foreground="{ThemeResource MutedBrush}"/>
                        </Button>
                        <AutoSuggestBox x:Name="AddTagBox" Visibility="Collapsed"
                                        PlaceholderText="Tag name (Enter to add)"
                                        Width="180"
                                        QuerySubmitted="OnAddTagSubmitted"
                                        TextChanged="OnAddTagTextChanged"
                                        LostFocus="OnAddTagBlur"
                                        VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- v4.2.0 (#14): facts, plot, notes and details, one under another (v5.3.0: the facts
                     as a row of tiles). In a wide window the code moves them beside the poster. -->
                <StackPanel x:Name="BodyStack">
                    <StackPanel x:Name="BodyMain"/>

                    <!-- v5.3.0: tiles for the ratings, about the film, the file and the IDs, built in code;
                         each as wide as what's in it, and the tiles in a row as tall as each other -->
                    <Border x:Name="FactsCard" Visibility="Collapsed" Margin="0,20,0,0">
                        <controls:WrapPanel x:Name="FactsStack" HorizontalSpacing="12" VerticalSpacing="12"/>
                    </Border>

                    <!-- Plot — with section header + capped width for readability -->
                    <StackPanel x:Name="PlotBlock">
                        <StackPanel x:Name="PlotSection" Visibility="Collapsed" Margin="0,20,0,0" Spacing="8">
                            <TextBlock Text="OVERVIEW" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="150"
                                       Foreground="{ThemeResource DetailStoryBrush}"/>
                            <TextBlock x:Name="PlotText" FontSize="14" Foreground="{ThemeResource TextBrush}"
                                       TextWrapping="Wrap" LineHeight="22" MaxWidth="780"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Notes (v1.9). v5.3.0: only with a note, or while writing one -->
                    <Border x:Name="NotesCard" Visibility="Collapsed" Margin="0,20,0,0" Padding="14,12"
                            Background="{ThemeResource CardBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📝 Notes"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="NoteEditBtn" Click="OnNoteEditStart"
                                            Content="Edit" Visibility="Collapsed"
                                            Background="Transparent"
                                            Foreground="{ThemeResource MutedBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}"
                                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                                    <Button x:Name="NoteSaveBtn" Click="OnNoteSave"
                                            Content="Save" Visibility="Collapsed"
                                            Background="{StaticResource BrandPurpleBrush}"
                                            Foreground="#FFFFFF"
                                            BorderThickness="0"
                                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                                    <Button x:Name="NoteCancelBtn" Click="OnNoteCancel"
                                            Content="Cancel" Visibility="Collapsed"
                                            Background="Transparent"
                                            Foreground="{ThemeResource MutedBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}"
                                            CornerRadius="6" Padding="10,4" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="NoteText" Visibility="Collapsed"
                                       FontSize="13" Foreground="{ThemeResource TextBrush}"
                                       TextWrapping="Wrap" LineHeight="20"/>
                            <TextBox x:Name="NoteEditor" Visibility="Collapsed"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="100" MaxHeight="240"
                                     PlaceholderText="What did you think of this film?"
                                     FontSize="13"/>
                            <TextBlock x:Name="NoteOfflineHint" Visibility="Collapsed"
                                       Text="Drive offline — note saved locally; will sync to the movie folder when reconnected."
                                       FontSize="11" Foreground="{ThemeResource MutedBrush}"
                                       FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- v5.3.0: people (director, writer) and production (studios, country), coloured
                         by kind, in a row of four, two by two or one under another; filled in code -->
                    <StackPanel x:Name="FieldsBlock">
                        <Grid x:Name="FieldsGrid" Margin="0,24,0,0" ColumnSpacing="28" RowSpacing="18"
                              SizeChanged="OnFieldsGridSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="DirectorField" Visibility="Collapsed"/>
                            <StackPanel x:Name="WriterField" Visibility="Collapsed"/>
                            <StackPanel x:Name="StudioField" Visibility="Collapsed"/>
                            <StackPanel x:Name="CountryField" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Divider above Cast -->
                <Border x:Name="CastDivider" Visibility="Collapsed"
                        Height="1" Background="{ThemeResource BorderBrush}"
                        Margin="0,24,0,0" Opacity="0.5"/>
                <!-- Cast — wraps to multiple rows, no side-scroll -->
                <StackPanel x:Name="CastSection" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock Text="Cast" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" Margin="0,0,0,10"/>
                        <ItemsRepeater x:Name="CastRepeater">
                            <ItemsRepeater.Layout>
                                <!-- Portrait 2:3 cards: image 140×210 + name/role. The height is
                                     set in code to fit the longest name and role (v3.8.0). -->
                                <UniformGridLayout x:Name="CastGridLayout" MinItemWidth="150" MinItemHeight="280"
                                                   MinColumnSpacing="14" MinRowSpacing="18"
                                                   ItemsStretch="None"
                                                   Orientation="Horizontal"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:Actor">
                                    <Button Width="140"
                                            Background="Transparent"
                                            BorderThickness="0" Padding="0"
                                            CornerRadius="10"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Tag="{x:Bind Name}"
                                            Click="OnActorClick">
                                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                            <!-- 2:3 portrait headshot (140 × 210, rounded) -->
                                            <Border Width="140" Height="210"
                                                    CornerRadius="10"
                                                    Background="{ThemeResource PlaceholderBgBrush}"
                                                    BorderBrush="{ThemeResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <!-- Initials sit behind the image and show
                                                         through when the thumbnail is missing
                                                         or fails to load. -->
                                                    <TextBlock Text="{x:Bind Initials}"
                                                               FontSize="34" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource MutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Stretch="UniformToFill"
                                                           Source="{x:Bind ThumbBitmap, Mode=OneWay}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="WrapWholeWords"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"/>
                                            <TextBlock Text="{x:Bind Role, TargetNullValue=''}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource MutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="WrapWholeWords"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    <!-- v4.4.1: a very big cast shows its first 24 until this is clicked -->
                    <Button x:Name="CastShowAllBtn" Visibility="Collapsed" Click="OnCastShowAll"
                            Margin="0,14,0,0"
                            Background="{ThemeResource CardBrush}"
                            Foreground="{ThemeResource TextBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            CornerRadius="8" Padding="14,7"/>
                </StackPanel>

                <!-- v4.5.0: the rest of its collection, then more by its director,
                     from the films you own. A click shows that film here. -->
                <StackPanel x:Name="CollectionSection" Visibility="Collapsed">
                    <Border Height="1" Background="{ThemeResource BorderBrush}"
                            Margin="0,24,0,0" Opacity="0.5"/>
                    <TextBlock x:Name="CollectionHeader" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" Margin="0,20,0,10"
                               TextWrapping="Wrap"/>
                    <ItemsRepeater x:Name="CollectionRepeater" ItemTemplate="{StaticResource RelatedMovieTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="120" MinColumnSpacing="14" MinRowSpacing="16"
                                               ItemsStretch="None" Orientation="Horizontal"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
                <StackPanel x:Name="DirectorSection" Visibility="Collapsed">
                    <Border Height="1" Background="{ThemeResource BorderBrush}"
                            Margin="0,24,0,0" Opacity="0.5"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,10">
                        <TextBlock x:Name="DirectorHeader" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"/>
                        <HyperlinkButton x:Name="DirectorSeeAllBtn" Click="OnDirectorSeeAll"
                                         Padding="0" FontSize="13" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                    </StackPanel>
                    <ItemsRepeater x:Name="DirectorRepeater" ItemTemplate="{StaticResource RelatedMovieTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="120" MinColumnSpacing="14" MinRowSpacing="16"
                                               ItemsStretch="None" Orientation="Horizontal"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky action bar (v2.3) — appears once you scroll past the hero -->
        <Border x:Name="StickyBar" Visibility="Collapsed"
                Background="{ThemeResource StickyBarBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="52" VerticalAlignment="Top">
            <Grid Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- v4.8.0 (#25): back to the library, where the ✕ on the right was -->
                <Button Grid.Column="0" Click="OnBackToLibrary" VerticalAlignment="Center"
                        Style="{StaticResource RowIconToggleStyle}" Width="Auto"
                        Foreground="{ThemeResource TextBrush}" Margin="0,0,12,0"
                        AutomationProperties.Name="Back to library"
                        ToolTipService.ToolTip="Back to library (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0,14,0">
                        <FontIcon Glyph="&#xE76B;" FontSize="12"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        <TextBlock Text="Library" FontSize="13"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="StickyTitle" Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- v4.5.0: previous / next, as on the banner -->
                    <StackPanel x:Name="StickyBrowseNav" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                        <Button x:Name="StickyPrevBtn" Click="OnPrevMovie"
                                Style="{StaticResource RowIconToggleStyle}" Foreground="{ThemeResource TextBrush}"
                                AutomationProperties.Name="Previous movie"
                                ToolTipService.ToolTip="Previous movie (←)">
                            <FontIcon Glyph="&#xE76B;" FontSize="12"
                                      FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        </Button>
                        <Button x:Name="StickyNextBtn" Click="OnNextMovie"
                                Style="{StaticResource RowIconToggleStyle}" Foreground="{ThemeResource TextBrush}"
                                AutomationProperties.Name="Next movie"
                                ToolTipService.ToolTip="Next movie (→)">
                            <FontIcon Glyph="&#xE76C;" FontSize="12"
                                      FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="StickyPlayBtn" Click="OnPlay"
                            Background="#A78BFA" Foreground="White"
                            BorderThickness="0" CornerRadius="6" Padding="14,5">
                        <TextBlock Text="▶ Play"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5.3.0: back from a film played in another player, after most of its length: was it finished?
             As the main window's toast looks -->
        <Border x:Name="FinishedBar" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,24"
                Background="{ThemeResource ToastBgBrush}" CornerRadius="10" Padding="16,12"
                BorderBrush="{StaticResource BrandPurpleBrush}" BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Border.Translation>0,0,32</Border.Translation>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="FinishedText" Foreground="{ThemeResource TextBrush}"
                           VerticalAlignment="Center" FontSize="13"/>
                <Button x:Name="FinishedYesBtn" Content="Mark watched" Click="OnFinishedYes"
                        Background="{StaticResource BrandPurpleBrush}" Foreground="#FFFFFF" BorderThickness="0"
                        CornerRadius="6" Padding="10,4" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Not yet" Click="OnFinishedNo"
                        Background="Transparent" Foreground="{ThemeResource MutedBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" CornerRadius="6" Padding="10,4" FontSize="12"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
