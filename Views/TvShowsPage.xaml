<Page
    x:Class="CineLibraryCS.Views.TvShowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    xmlns:models="using:CineLibraryCS.Models"
    xmlns:controls="using:CineLibraryCS.Controls"
    Background="{ThemeResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="EpisodeCardTemplate" x:DataType="models:TvEpisodeItem">
            <local:TvEpisodeCard Episode="{x:Bind}"/>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: one row (v3.9.0), like All movies: back + title + count |
             watched pills | sort + poster size. HeaderBar wraps it when narrow. -->
        <controls:HeaderBar Grid.Row="0" Margin="24,8,24,10" HorizontalSpacing="16" VerticalSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="BackBtn" Click="OnBackClick"
                        Background="{ThemeResource InputBgBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,6" Height="36"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="‹" FontSize="18" FontWeight="Bold"
                                   Foreground="{ThemeResource TextBrush}"/>
                        <TextBlock x:Name="BackLabel" Text="Back" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TitleText" Text="All TV shows" FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SubText" Text="" FontSize="13"
                           Foreground="{ThemeResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- v3.7.0: watched filter, same pills as All movies. -->
            <StackPanel x:Name="TvFilterPills" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="TvFilterAll" Content="All" Tag="all"
                        Style="{StaticResource PillButtonActiveStyle}" Click="OnTvFilterClick"/>
                <Button x:Name="TvFilterUnwatched" Content="Unwatched" Tag="unwatched"
                        Style="{StaticResource PillButtonStyle}" Click="OnTvFilterClick"
                        ToolTipService.ToolTip="Shows with episodes you haven't watched yet"/>
                <Button x:Name="TvFilterWatched" Content="Watched" Tag="watched"
                        Style="{StaticResource PillButtonStyle}" Click="OnTvFilterClick"
                        ToolTipService.ToolTip="Shows you've watched every episode of"/>
            </StackPanel>

            <!-- v3.7.0: sort + poster size for All TV shows, matching All movies. -->
            <StackPanel x:Name="TvToolbar" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <ComboBox x:Name="TvSortCombo"
                          SelectionChanged="OnTvSortChanged"
                          Background="{ThemeResource InputBgBrush}"
                          Foreground="{ThemeResource TextBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}"
                          Width="160" Height="36" CornerRadius="8"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Sort shows">
                    <ComboBoxItem Tag="title:asc"        Content="Title ↑"/>
                    <ComboBoxItem Tag="title:desc"       Content="Title ↓"/>
                    <ComboBoxItem Tag="year:desc"        Content="Year ↓"/>
                    <ComboBoxItem Tag="year:asc"         Content="Year ↑"/>
                    <ComboBoxItem Tag="rating:desc"      Content="Rating ↓"/>
                    <ComboBoxItem Tag="rating:asc"       Content="Rating ↑"/>
                    <ComboBoxItem Tag="date_added:desc"  Content="Date Added ↓"/>
                    <ComboBoxItem Tag="date_added:asc"   Content="Date Added ↑"/>
                    <ComboBoxItem Tag="last_played:desc" Content="Last Watched ↓"/>
                    <ComboBoxItem Tag="last_played:asc"  Content="Last Watched ↑"/>
                </ComboBox>
                <DropDownButton Background="{ThemeResource InputBgBrush}"
                                Foreground="{ThemeResource TextBrush}"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                CornerRadius="8" Height="36" Padding="12,0,10,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Poster size"
                                ToolTipService.ToolTip="Poster size">
                    <TextBlock x:Name="TvDensityLabel" Text="Size: M" FontSize="13"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem x:Name="TvDensityS" Text="Small" Tag="S" GroupName="tvdensity"
                                                 KeyboardAcceleratorTextOverride="S" Click="OnTvDensityClick"/>
                            <RadioMenuFlyoutItem x:Name="TvDensityM" Text="Medium" Tag="M" GroupName="tvdensity"
                                                 KeyboardAcceleratorTextOverride="M" Click="OnTvDensityClick"/>
                            <RadioMenuFlyoutItem x:Name="TvDensityL" Text="Large" Tag="L" GroupName="tvdensity"
                                                 KeyboardAcceleratorTextOverride="L" Click="OnTvDensityClick"/>
                            <RadioMenuFlyoutItem x:Name="TvDensityXL" Text="Extra large" Tag="XL" GroupName="tvdensity"
                                                 KeyboardAcceleratorTextOverride="XL" Click="OnTvDensityClick"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </controls:HeaderBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <Grid>
                <!-- LEVEL 1: Shows grid. v4.1.0: the Continue Watching row that sat
                     above it is gone; the Continue Watching page lists those shows. -->
                <StackPanel x:Name="ShowsLevelHost" Spacing="0">
                    <ItemsRepeater x:Name="ShowsRepeater" Margin="24,0,24,24">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="ShowsGridLayout" MinItemWidth="170" MinItemHeight="300"
                                               MinColumnSpacing="14" MinRowSpacing="14"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TvShowListItem">
                                <local:TvShowCard Show="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- LEVEL 2: Show header + Seasons grid -->
                <StackPanel x:Name="SeasonsPanel" Visibility="Collapsed" Spacing="0">
                    <!-- Show-detail header. v3.10.0: the fanart is a full-brightness
                         banner at a fixed height, with IMDb / TMDb on it; the poster
                         overlaps its bottom edge and the info sits below, as in the
                         movie details window. The card ends after the cast, so a wide
                         window no longer stretches it (the old fanart filled the card
                         and set its height from the picture's shape). -->
                    <Grid x:Name="ShowHeader" Margin="24,4,24,24">
                        <Border CornerRadius="14" Background="#0E0E16">
                            <Grid>
                                <StackPanel>
                                    <Grid x:Name="ShowBanner" Height="300">
                                        <Image x:Name="ShowFanart" Stretch="UniformToFill"/>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0"    Color="#33000000"/>
                                                    <GradientStop Offset="0.55" Color="#110E0E16"/>
                                                    <GradientStop Offset="1"    Color="#FF0E0E16"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="ShowInfoGrid" Padding="28,0,28,24" ColumnSpacing="28" Margin="0,-110,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Poster -->
                                        <Border Grid.Column="0" Width="150" Height="225" CornerRadius="10"
                                                VerticalAlignment="Top"
                                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                                Background="{ThemeResource PlaceholderBgBrush}">
                                            <Grid>
                                                <TextBlock Text="📺" FontSize="40" Opacity="0.6"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="ShowPoster" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <!-- Meta -->
                                        <StackPanel x:Name="ShowMeta" Grid.Column="1" Spacing="14" VerticalAlignment="Top"
                                                    Margin="0,122,0,0">
                                            <TextBlock x:Name="ShowTitle" FontSize="26" FontWeight="Bold"
                                                       Foreground="White" TextWrapping="Wrap"/>
                                            <controls:WrapPanel x:Name="ShowMetaRow" HorizontalSpacing="14" VerticalSpacing="4">
                                                <TextBlock x:Name="ShowYear" FontSize="13" Foreground="#D8D8D8"/>
                                                <TextBlock x:Name="ShowRating" FontSize="13" Foreground="#F59E0B"/>
                                                <TextBlock x:Name="ShowMpaa" FontSize="13" Foreground="#D8D8D8"/>
                                                <TextBlock x:Name="ShowStatus" FontSize="13" Foreground="#A78BFA"/>
                                                <TextBlock x:Name="ShowProgress" FontSize="13" Foreground="#D8D8D8"/>
                                                <TextBlock x:Name="ShowStudio" FontSize="13" Foreground="#D8D8D8"/>
                                            </controls:WrapPanel>
                                            <!-- v4.4.1 (#20): genres right under the info line, above the plot and note -->
                                            <StackPanel x:Name="ShowGenres" Orientation="Horizontal" Spacing="6"/>
                                            <TextBlock x:Name="ShowPlot" FontSize="14" LineHeight="22" Foreground="#E0E0E0"
                                                       TextWrapping="Wrap" MaxLines="5"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="760"
                                                       HorizontalAlignment="Left"/>
                                            <!-- v4.3.0 (#17): the show's own note, under the plot -->
                                            <Grid x:Name="ShowNoteWrap" Visibility="Collapsed" ColumnSpacing="10"
                                                  MaxWidth="760" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource BrandPurpleBrush}" CornerRadius="2"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="YOUR NOTE" FontSize="11" FontWeight="SemiBold"
                                                               CharacterSpacing="120" Foreground="#9CA3AF"/>
                                                    <TextBlock x:Name="ShowNoteText" FontSize="13" LineHeight="20"
                                                               Foreground="#E0E0E0" TextWrapping="Wrap" MaxLines="4"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- v4.0.1: drive location, as in the movie window -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Located on:" FontSize="12" Foreground="#A0A0A0"
                                                           VerticalAlignment="Center"/>
                                                <Ellipse x:Name="ShowDriveDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ShowDriveText" FontSize="12" Foreground="#D8D8D8"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <!-- Action buttons, then tags (v3.10.0: tags moved up
                                                 next to Add to list). Wraps in narrow windows. -->
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Margin="0,6,0,0">
                                                <Button x:Name="PlayNextBtn" Click="OnPlayNext"
                                                        Background="{StaticResource BrandPurpleBrush}" Foreground="White"
                                                        BorderThickness="0" CornerRadius="8" Padding="16,7"
                                                        FontWeight="SemiBold"/>
                                                <Button x:Name="ShowFolderBtn" Content="📂 Open Folder" Click="OnOpenShowFolder"
                                                        Background="#22FFFFFF" Foreground="White"
                                                        BorderThickness="0" CornerRadius="8" Padding="14,7"/>
                                                <Button x:Name="ShowFavBtn" Click="OnToggleShowFavorite"
                                                        Background="#22FFFFFF" Foreground="White"
                                                        BorderThickness="0" CornerRadius="8" Padding="14,7"/>
                                                <Button x:Name="ShowWatchlistBtn" Click="OnToggleShowWatchlist"
                                                        Background="#22FFFFFF" Foreground="White"
                                                        BorderThickness="0" CornerRadius="8" Padding="14,7"/>
                                                <Button x:Name="ShowListsBtn" Content="📑 Add to list"
                                                        Background="#22FFFFFF" Foreground="White"
                                                        BorderThickness="0" CornerRadius="8" Padding="14,7">
                                                    <Button.Flyout>
                                                        <MenuFlyout x:Name="ShowListsFlyout" Placement="Bottom"
                                                                    Opening="OnShowListsFlyoutOpening"/>
                                                    </Button.Flyout>
                                                </Button>
                                            </controls:WrapPanel>

                                            <!-- v3.10.0: TMDB fill-in, as in the movie details window.
                                                 Fills only what the show is missing. -->
                                            <!-- v4.4.1 (#20): tags sit after these buttons and wrap in their own space,
                                                 so adding many never pushes this row away from the buttons above -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                                    <!-- v4.3.0 (#17) -->
                                                    <Button x:Name="ShowNoteBtn" Click="OnEditShowNote"
                                                            Background="#22FFFFFF" Foreground="White"
                                                            BorderThickness="0" CornerRadius="8" Padding="12,7">
                                                        <TextBlock x:Name="ShowNoteBtnText" Text="📝 Add note"/>
                                                    </Button>
                                                    <Button x:Name="FetchShowTmdbBtn" Click="OnFetchShowMissing"
                                                            Background="#22FFFFFF" Foreground="White"
                                                            BorderThickness="0" CornerRadius="8" Padding="12,7"
                                                            ToolTipService.ToolTip="Look this show up on TMDb and fill in only the details it's missing">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE896;" FontSize="14"
                                                                      FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                                            <TextBlock Text="Fetch missing info from TMDB"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <ProgressRing x:Name="ShowTmdbBusy" IsActive="False" Width="18" Height="18"
                                                                  VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ShowTmdbStatus" Visibility="Collapsed" FontSize="12"
                                                               Foreground="#B8B8C4" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- v2.9 show tags: chips with ✕ to remove, "+ Add tag" suggests existing ones -->
                                                <controls:WrapPanel x:Name="ShowTagsRow" Grid.Column="1" HorizontalSpacing="6"
                                                                    VerticalSpacing="6" VerticalAlignment="Top" Margin="4,5,0,0">
                                                    <TextBlock Text="🏷" FontSize="13"
                                                               Foreground="#D8D8D8"
                                                               VerticalAlignment="Top" Margin="0,4,0,0" Opacity="0.8"/>
                                                    <ItemsControl x:Name="ShowTagChipsRepeater" VerticalAlignment="Top">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <Button x:Name="AddShowTagBtn" Click="OnAddShowTagClick"
                                                            Background="#22FFFFFF"
                                                            BorderBrush="#33FFFFFF"
                                                            BorderThickness="1" CornerRadius="12"
                                                            Padding="10,3"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="+ Add tag" FontSize="11"
                                                                   Foreground="#D8D8D8"/>
                                                    </Button>
                                                    <AutoSuggestBox x:Name="AddShowTagBox" Visibility="Collapsed"
                                                                    PlaceholderText="Tag name (Enter to add)"
                                                                    Width="180"
                                                                    QuerySubmitted="OnAddShowTagSubmitted"
                                                                    TextChanged="OnAddShowTagTextChanged"
                                                                    LostFocus="OnAddShowTagBlur"
                                                                    VerticalAlignment="Center"/>
                                                </controls:WrapPanel>
                                            </Grid>

                                            <!-- Cast: v3.10.0 portrait cards like the movie details
                                                 window, smaller, on one line that scrolls sideways. -->
                                            <StackPanel x:Name="ShowCastSection" Spacing="8" Margin="0,6,0,0">
                                                <TextBlock Text="CAST" FontSize="11" FontWeight="SemiBold"
                                                           CharacterSpacing="120" Foreground="#9CA3AF"/>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              HorizontalScrollMode="Enabled"
                                                              VerticalScrollMode="Disabled"
                                                              Padding="0,0,0,12">
                                                    <ItemsRepeater x:Name="CastRepeater">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="12"/>
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Actor">
                                                                <StackPanel Width="100" Spacing="4" VerticalAlignment="Top">
                                                                    <Border Width="100" Height="150" CornerRadius="8"
                                                                            Background="#22FFFFFF"
                                                                            BorderBrush="#26FFFFFF" BorderThickness="1">
                                                                        <Grid>
                                                                            <TextBlock Text="{x:Bind Initials}" FontSize="24"
                                                                                       FontWeight="SemiBold" Foreground="#9CA3AF"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            <Image Stretch="UniformToFill"
                                                                                   Source="{x:Bind ThumbBitmap, Mode=OneWay}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="#E0E0E0" TextAlignment="Center"
                                                                               TextWrapping="WrapWholeWords" MaxLines="2"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{x:Bind Role, TargetNullValue=''}" FontSize="11"
                                                                               Foreground="#9CA3AF" TextAlignment="Center"
                                                                               TextWrapping="WrapWholeWords" MaxLines="2"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <!-- IMDb / TMDb, top right: on the banner, or in the corner
                                     of the card when the show has no fanart. -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="14"
                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="ShowImdbBtn" Visibility="Collapsed" Click="OnOpenShowImdb"
                                            Background="#F5C518" Foreground="#000000"
                                            BorderThickness="0" CornerRadius="4"
                                            Padding="8,3" FontSize="11" FontWeight="Bold"
                                            Content="IMDb" AutomationProperties.Name="Open on IMDb"/>
                                    <Button x:Name="ShowTmdbBtn" Visibility="Collapsed" Click="OnOpenShowTmdb"
                                            Background="#01D277" Foreground="#000000"
                                            BorderThickness="0" CornerRadius="4"
                                            Padding="8,3" FontSize="11" FontWeight="Bold"
                                            Content="TMDb" AutomationProperties.Name="Open on TMDb"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- v2.8 — inline season sections: each season is a header
                         + a wrap of episode cards, built in code-behind. No
                         drill-down; you scroll the whole show on one page. -->
                    <StackPanel x:Name="SeasonSectionsHost" Margin="0,0,0,24" Spacing="18"/>
                </StackPanel>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,80,0,24" Spacing="8">
                    <TextBlock Text="📺" FontSize="48" HorizontalAlignment="Center" Opacity="0.7"/>
                    <TextBlock x:Name="EmptyTitle" Text="No TV shows yet"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHint"
                               Text="Add a drive whose folders contain tvshow.nfo (MediaElch-scraped shows), then Update Database."
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
