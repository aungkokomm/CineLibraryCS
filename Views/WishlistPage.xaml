<Page
    x:Class="CineLibraryCS.Views.WishlistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    xmlns:models="using:CineLibraryCS.Models"
    Background="{ThemeResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="FilmCardTemplate" x:DataType="models:TmdbFilmItem">
            <local:TmdbFilmCard Item="{x:Bind}"/>
        </DataTemplate>
    </Page.Resources>

    <!-- 5.4.0: films you want and don't have yet (see Services/Wishlist) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,8,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Wishlist" FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextBrush}"/>
                <TextBlock Text="Films you want and don't have yet. Add them with + on an actor's or director's page; click a poster to open it on TMDb."
                           FontSize="12" Foreground="{ThemeResource MutedBrush}"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="13" Foreground="{ThemeResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <Button x:Name="CopyBtn" Click="OnCopyList"
                        Background="Transparent" Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,8"
                        ToolTipService.ToolTip="Copy the films still to get, one per line, with their years">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Copy list" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,24" Spacing="12">

                <!-- The ones you've got since adding them -->
                <StackPanel x:Name="OwnedSection" Visibility="Collapsed" Spacing="12" Margin="0,0,0,16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OwnedHeader" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150"
                                   Opacity="0.75" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
                        <HyperlinkButton Grid.Column="1" Content="Take these off the wishlist" Click="OnTakeOffOwned"
                                         VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsRepeater x:Name="OwnedRepeater" TabFocusNavigation="Once"
                                   ItemTemplate="{StaticResource FilmCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="150" MinItemHeight="269" MinColumnSpacing="24"
                                               MinRowSpacing="28" ItemsStretch="Uniform"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <TextBlock x:Name="WantedHeader" Text="STILL TO GET" Visibility="Collapsed"
                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="150"
                           Opacity="0.75" Foreground="{ThemeResource MutedBrush}"/>
                <ItemsRepeater x:Name="WantedRepeater" TabFocusNavigation="Once"
                               ItemTemplate="{StaticResource FilmCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinItemHeight="269" MinColumnSpacing="24"
                                           MinRowSpacing="28" ItemsStretch="Uniform"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!-- Empty -->
                <Border x:Name="EmptyState" Visibility="Collapsed"
                        Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="28" Margin="0,8,0,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE719;" FontSize="28"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                  Foreground="{ThemeResource MutedBrush}"/>
                        <TextBlock Text="Nothing on your wishlist yet" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Open an actor or a director (click them in a movie's cast), then + on a film you don't have."
                                   Foreground="{ThemeResource MutedBrush}" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="420" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
