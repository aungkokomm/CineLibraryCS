<UserControl
    x:Class="CineLibraryCS.Views.MovieRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="Transparent" Padding="0,1"
            Tapped="OnTapped" DoubleTapped="OnDoubleTapped"
            PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
        <Border x:Name="RowBorder" Style="{StaticResource CardSurfaceStyle}"
                CornerRadius="8" Padding="12,10"
                BorderBrush="Transparent" BorderThickness="2">
            <Grid>
                <!-- v4.7.0 (#25): a bigger poster, and Play, rating, Watchlist,
                     Watched and Favorite as on a poster card. TvShowRowControl
                     keeps the same columns. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- Thumbnail -->
                <Border Grid.Column="0" Width="56" Height="84" CornerRadius="4">
                    <Grid>
                        <Image x:Name="ThumbImage" Stretch="UniformToFill"/>
                        <TextBlock x:Name="ThumbPlaceholder" Text="🎬" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Main info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="RowTitle" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="RowFav" Text="♥" Foreground="#F43F5E"
                                   FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="RowMeta" FontSize="12"
                               Foreground="{ThemeResource MutedBrush}" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                        <Ellipse x:Name="DriveDot" Width="7" Height="7" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DriveLabel" FontSize="11"
                                   Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Play, when its drive is connected (a double-click still plays) -->
                <Button Grid.Column="2" x:Name="PlayBtn" Content="▶ Play" Click="OnPlay"
                        Style="{StaticResource PillButtonActiveStyle}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Rating -->
                <TextBlock Grid.Column="3" x:Name="RowRating"
                           Foreground="#F59E0B" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Watchlist, Watched, Favorite -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="WatchlistBtn" Click="OnToggleWatchlist"
                            Style="{StaticResource RowIconToggleStyle}"
                            AutomationProperties.Name="Watchlist">
                        <FontIcon x:Name="WatchlistIcon" FontSize="14"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                    </Button>
                    <Button x:Name="WatchedBtn" Click="OnToggleWatched"
                            Style="{StaticResource RowIconToggleStyle}"
                            AutomationProperties.Name="Watched">
                        <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="14"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                    </Button>
                    <Button x:Name="FavBtn" Click="OnToggleFav"
                            Style="{StaticResource RowIconToggleStyle}"
                            AutomationProperties.Name="Favorite">
                        <FontIcon x:Name="FavIcon" FontSize="14"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>

                <!-- Status -->
                <Border Grid.Column="5" x:Name="RowStatusBadge"
                        CornerRadius="4" Padding="8,3"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="RowStatusText" FontSize="11" FontWeight="Bold"
                               Foreground="{ThemeResource TextBrush}"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
