<ContentDialog
    x:Class="CineLibraryCS.Views.TmdbPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    Title="Match this movie on TMDb"
    PrimaryButtonText="Use this match"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="10" MinWidth="460">
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}"
                   Text="Pick the correct film so the missing details are filled from the right entry."/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox" Grid.Column="0" PlaceholderText="Movie title…" KeyDown="OnTitleKeyDown"/>
            <TextBox x:Name="YearBox" Grid.Column="1" PlaceholderText="Year" Width="72" MaxLength="4" InputScope="Number"/>
            <Button x:Name="SearchBtn" Grid.Column="2" Content="Search" Click="OnSearch"
                    Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>
        <Grid>
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" HorizontalAlignment="Left"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource MutedBrush}"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <ListView x:Name="ResultsList" Height="240" SelectionMode="Single"
                  SelectionChanged="OnResultSelected"
                  BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TmdbResultItem">
                    <Grid ColumnSpacing="10" Padding="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="46" Height="69" CornerRadius="4"
                                Background="{ThemeResource InputBgBrush}">
                            <Image Source="{x:Bind Thumb}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextBrush}"/>
                            <TextBlock Text="{x:Bind SubLine}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                            <TextBlock Text="{x:Bind Overview}" FontSize="12" Foreground="{ThemeResource MutedBrush}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
