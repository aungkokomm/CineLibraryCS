<Page
    x:Class="CineLibraryCS.Views.DupesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CineLibraryCS.Views"
    xmlns:models="using:CineLibraryCS.Models"
    Background="{ThemeResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,8,24,12" Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Dupes" FontSize="24" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}"/>
                    <TextBlock Text="Movies you have more than once. Copies kept in different audio languages, quality, codec or edition are kept on purpose — only same-version copies are flagged as possible duplicates."
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"
                               TextWrapping="Wrap" MaxWidth="680"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                    <TextBlock x:Name="CountText" FontSize="13" HorizontalAlignment="Right"
                               Foreground="{ThemeResource MutedBrush}"/>
                    <TextBlock x:Name="ReclaimHeadline" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Foreground="{ThemeResource AccentGreenBrush}"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <CheckBox x:Name="OnlyDupesCheck" Content="Only possible duplicates"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                              Foreground="{ThemeResource TextBrush}"/>
                    <CheckBox x:Name="ShowIgnoredCheck" Content="Show ignored"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                              Foreground="{ThemeResource TextBrush}"/>
                </StackPanel>
                <Button x:Name="RescanBtn" Grid.Column="1" Click="OnRescan"
                        Height="32" CornerRadius="8" Padding="12,0" VerticalAlignment="Center"
                        Background="{ThemeResource InputBgBrush}"
                        Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        ToolTipService.ToolTip="Re-check the files on disk and refresh — run this after you delete a copy">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"
                                  FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        <TextBlock Text="Rescan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Groups -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsRepeater x:Name="GroupsRepeater" Margin="24,4,24,24">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DupeGroup">
                            <Border Background="{ThemeResource CardBrush}"
                                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,12">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Poster -->
                                    <Border Width="52" Height="78" CornerRadius="6" VerticalAlignment="Top"
                                            Background="{ThemeResource InputBgBrush}">
                                        <Grid>
                                            <TextBlock Text="{x:Bind PosterInitial}" FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <!-- Header row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TitleYear}" FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind Summary}" FontSize="12"
                                                               Foreground="{ThemeResource MutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind ReclaimableText}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentGreenBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind ReclaimVisibility}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Border CornerRadius="6" Padding="8,3"
                                                        Background="{ThemeResource InputBgBrush}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind VerifyVisibility}"
                                                        ToolTipService.ToolTip="Matched by title + year only — no TMDb/IMDb id. Worth a quick check.">
                                                    <TextBlock Text="verify" FontSize="11"
                                                               Foreground="{ThemeResource MutedBrush}"/>
                                                </Border>
                                                <Border CornerRadius="6" Padding="8,3"
                                                        Background="{ThemeResource InputBgBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind BadgeText}" FontSize="12"
                                                               Foreground="{ThemeResource TextBrush}"/>
                                                </Border>
                                                <Button Content="{x:Bind IgnoreLabel}" Tag="{x:Bind}"
                                                        Click="OnToggleIgnore" Padding="10,4" FontSize="12"
                                                        Background="Transparent"
                                                        Foreground="{ThemeResource MutedBrush}"
                                                        BorderThickness="0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Copies -->
                                        <ItemsRepeater ItemsSource="{x:Bind Copies}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="4"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:DupeCopy">
                                                    <Grid ColumnSpacing="10" Padding="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind DriveText}" FontSize="13"
                                                                   Foreground="{ThemeResource TextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind MetaText}"
                                                                   FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- Actions — Open folder on every copy so you can
                                                             physically check both; keep chip on the recommended
                                                             one; W&G only on the removable copies. -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <Border CornerRadius="6" Padding="9,3"
                                                                    Background="{ThemeResource InputBgBrush}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{x:Bind KeeperChipVisibility}"
                                                                    ToolTipService.ToolTip="Best copy — highest quality / largest. Recommended to keep.">
                                                                <TextBlock Text="✓ keep" FontSize="12"
                                                                           Foreground="{ThemeResource TextBrush}"/>
                                                            </Border>
                                                            <Button Content="Open folder" Tag="{x:Bind}"
                                                                    Click="OnOpenFolder" Padding="10,4" FontSize="12"
                                                                    Background="{ThemeResource InputBgBrush}"
                                                                    Foreground="{ThemeResource TextBrush}"
                                                                    BorderBrush="{ThemeResource InputBorderBrush}"/>
                                                            <Button Content="→ W&amp;G" Tag="{x:Bind}"
                                                                    Click="OnSendToWg" Padding="10,4" FontSize="12"
                                                                    Background="{ThemeResource InputBgBrush}"
                                                                    Foreground="{ThemeResource TextBrush}"
                                                                    BorderBrush="{ThemeResource InputBorderBrush}"
                                                                    Visibility="{x:Bind ActionVisibility}"
                                                                    ToolTipService.ToolTip="Send this copy to Watched &amp; Gone (keeps a record, removes it from the library)"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,80,0,24" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="40"
                              FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No duplicates found" FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Every movie in your library appears once. Copies you keep in different languages, quality or editions aren't counted as duplicates."
                               FontSize="12" Foreground="{ThemeResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
